# Copy to /opt/mseezee/.env on the VPS (never commit the real one — it's
# referenced by deploy/docker-compose.yml's `env_file`).

# Point at the VPS's own Postgres — see deploy/README.md for creating the
# database and user.
DATABASE_URL=postgresql://mseezee:CHANGE_ME@localhost:5432/mseezee

# NextAuth — a *different* secret from the one in local .env.local.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Paystack — live keys only once the money model is decided and the account
# is live-activated. Until then this can stay pointed at test keys so the app
# runs, with the understanding that no real payment will complete.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# The site's public address. Required: behind Apache, Next.js reports its
# internal address (https://localhost:3210), so without this sign-in links and
# Paystack's return URL point there. Read at runtime by NextAuth and by the
# payment route.
AUTH_URL=https://mseezee.co.za

# Baked in at build time, so setting it here has no effect on the GitHub-built
# image — kept only for parity with local .env.local. AUTH_URL is what counts.
NEXT_PUBLIC_APP_URL=https://mseezee.co.za

# SMSPortal — same credentials as local, or a separate set if you want to
# track usage/cost separately per environment.
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=
SMSPORTAL_TEST_MODE=true

# Must match the port docker-compose.yml sets and the Apache vhost proxies to.
PORT=3210
