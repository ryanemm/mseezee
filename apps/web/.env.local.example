# Copy to apps/web/.env.local and fill in. .env.local is gitignored.

# Paystack — TEST keys only for the spike.
# Public key can be shared; secret key must never leave this file.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_6942c96bacf7c53eb95ecad2b5bf4b2ce158e79c
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# The partner subaccount contributions settle to (from scripts/paystack/create-subaccount.mjs).
PAYSTACK_TEST_SUBACCOUNT=ACCT_a1ra3ba7ejkjale

# Where Paystack sends the browser back after payment. Local default is fine —
# only the webhook (server-to-server) needs a public tunnel URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres. Local dev: `createdb mseezee_dev`, then use the line below as-is
# (adjust the username to your own if it isn't the default). The deployed app
# gets a different DATABASE_URL pointing at the VPS's Postgres.
DATABASE_URL=postgresql://YOUR_USERNAME@localhost:5432/mseezee_dev

# NextAuth — signs session tokens. Generate your own: `openssl rand -base64 32`.
AUTH_SECRET=

# SMSPortal — sends phone sign-in codes. cp.smsportal.com → API credentials.
# Unset is fine for dev: the OTP is logged to the server console instead.
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=
SMSPORTAL_TEST_MODE=true
